<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- the doc comments become descriptions in the OpenAPI document -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Fisher" Version="1.20.2" />
      <PackageReference Include="Fisher.AspNetCore" Version="1.20.2" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
      <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
      <PackageReference Include="WolverineFx" Version="6.50.2" />
      <PackageReference Include="WolverineFx.Fisher" Version="6.50.2" />
      <PackageReference Include="WolverineFx.Http" Version="6.50.2" />
      <PackageReference Include="WolverineFx.Http.Fisher" Version="6.50.2" />
      <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.50.2" />
    </ItemGroup>

</Project>
