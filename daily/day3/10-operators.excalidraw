    {
      "id": "nX9BLf6pS2epA02iVVY76",
      "type": "text",
      "x": 323,
      "y": 312,
      "width": 594,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 690526304,
      "version": 72,
      "versionNonce": 1973094496,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792582311058,
      "link": null,
      "locked": false,
      "text": "\n\n\nswitchMap: only the latest intent matters\nconcatMap: every intent counts, in order\nmergeMap: every intent counts, any order\nexhaustMap: ignore new intents until this one resolves\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\nswitchMap: only the latest intent matters\nconcatMap: every intent counts, in order\nmergeMap: every intent counts, any order\nexhaustMap: ignore new intents until this one resolves\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WfsAbJImWNHvRiOTiuRKC",
      "type": "text",
      "x": 311,
      "y": 257,
      "width": 1034,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "MrofxVkTWrwFcrJjuLIky",
      "index": "a2",
      "roundness": null,
      "seed": 119851424,
      "version": 26,
      "versionNonce": 1536370080,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792582322950,
      "link": null,
      "locked": false,
      "text": "An operator is a business policy with no name. \n- mergeMap buried in a pipe is a decision about what the business wants, and nothing says so. \n- Declaring it on the intent (an orderBy) names it, and makes it readable and testable. \n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An operator is a business policy with no name. \n- mergeMap buried in a pipe is a decision about what the business wants, and nothing says so. \n- Declaring it on the intent (an orderBy) names it, and makes it readable and testable. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rGx7t55SDXFHrTq0qT7iY",
      "type": "text",
      "x": 305,
      "y": 7,
      "width": 880,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ptfsVXCMZCw4VDAMpzz_I",
      "index": "a3",
      "roundness": null,
      "seed": 1822403680,
      "version": 252,
      "versionNonce": 1029581920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792582362152,
      "link": null,
      "locked": false,
      "text": "What is the intent? - when a submit button is clicked, what are we trying to do?\n- what can we honestly intend based on the veracity of our guess?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is the intent? - when a submit button is clicked, what are we trying to do?\n- what can we honestly intend based on the veracity of our guess?",
      "autoResize": true,
      "lineHeight": 1.25
    },
