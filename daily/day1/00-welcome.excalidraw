    {
      "id": "pzEz4-VsB2lhr40mGLTTi",
      "type": "text",
      "x": 1217,
      "y": 4,
      "width": 392.2396240234375,
      "height": 216,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 770190186,
      "version": 451,
      "versionNonce": 866302256,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "7UM2lO3MIBTHwY31rs-_l",
          "type": "arrow"
        }
      ],
      "updated": 1792424663741,
      "link": null,
      "locked": false,
      "text": "URL\n    - path (/customers/{id}/orders) - RFC 2616 \n    - matrix params (layout=big)\n    - route params ({id} = 128)\n        - In angular you can read these as inputs now.*\n    - query string (status=placed)\n        - apply to the resource, if you want that value\n           to persist on parent routes, use matrix params.\n        - if there is a collection, this is the \"where\" clause.\n            - http standard",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "URL\n    - path (/customers/{id}/orders) - RFC 2616 \n    - matrix params (layout=big)\n    - route params ({id} = 128)\n        - In angular you can read these as inputs now.*\n    - query string (status=placed)\n        - apply to the resource, if you want that value\n           to persist on parent routes, use matrix params.\n        - if there is a collection, this is the \"where\" clause.\n            - http standard",
      "autoResize": true,
      "lineHeight": 1.35
    },
