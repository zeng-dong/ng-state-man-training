      "isDeleted": false,
      "boundElements": null,
      "updated": 1792599801675,
      "link": null,
      "locked": false,
      "text": "\"The business won't let us do any caching at all!\"\n    - in every situation we want to make sure the user is working from the latest version\n      of the supporting data - cool. That has nothing to do with cache headers, really.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"The business won't let us do any caching at all!\"\n    - in every situation we want to make sure the user is working from the latest version\n      of the supporting data - cool. That has nothing to do with cache headers, really.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
