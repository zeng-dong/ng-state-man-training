      "updated": 1792425944472,
      "link": null,
      "locked": false,
      "text": "Observables - \"Reactive Programming' - actually started at Microsoft from the folks that created LINQ.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observables - \"Reactive Programming' - actually started at Microsoft from the folks that created LINQ.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "c_pseyOI1dgqy43Xr-KbA",
      "type": "text",
      "x": 560.0305368031524,
      "y": 1246.3220956657196,
      "width": 506,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 2013063472,
      "version": 83,
      "versionNonce": 1878949168,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792426018775,
      "link": null,
      "locked": false,
      "text": "\"Reactive Extensions C#\" -\n    - let's us \"observe\" subjects *over time*.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Reactive Extensions C#\" -\n    - let's us \"observe\" subjects *over time*.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
